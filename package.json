{
  "name": "svnckh-net",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "dev:temp": "vite --configLoader runner --host 127.0.0.1 --open /temp/",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --configLoader runner",
    "build:pages": "npm run typecheck && vite build --configLoader runner --mode pages",
    "preview": "vite preview --configLoader runner --host 127.0.0.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "tailwindcss": "^3.4.18",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  }
}
