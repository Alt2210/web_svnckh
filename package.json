{
  "name": "svnckh-net",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @svnckh/frontend",
    "typecheck": "npm run typecheck --workspace @svnckh/frontend",
    "test": "node --test tests/*.test.mjs && npm run test --workspaces --if-present",
    "build": "npm run build --workspace @svnckh/frontend",
    "build:pages": "npm run build:pages --workspace @svnckh/frontend",
    "preview": "npm run preview --workspace @svnckh/frontend"
  }
}
